    3: ['beautiful','computer','elephant','important','knowledge','vegetable','wonderful','adventure','butterfly','chocolate'],
};
function startTyping() {
    const grade = Math.min(3, Math.max(1, appState.currentGrade <= 2 ? 1 : appState.currentGrade <= 4 ? 2 : 3));
    gameState = {
        type:'typing', words:[...TYPING_LEVELS[grade]],
        i:0, input:'', correct:0, wrong:0, totalChars:0, typedChars:0,
        start:Date.now(), timeLimit:90, time:90
    };
    renderTyping();
    gameState._timer = setInterval(() => {
