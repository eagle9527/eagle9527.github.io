function calcStars(correct, total, extraGood=false) {
    if (total <= 0) return 0;
    const rate = correct / total;
    let s = 0;
    if (rate >= 1 && extraGood) s = 5;
    else if (rate >= 0.95) s = 5;
    else if (rate >= 0.8) s = 3;
    else if (rate >= 0.6) s = 2;
    else if (rate >= 0.4) s = 1;
    return s;
}

