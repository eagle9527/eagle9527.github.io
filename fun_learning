function popWhackMole() {
    // 选择空格子弹出
    const empty = [];
    gameState.holes.forEach((h, i) => { if (!h || Date.now()-h.t>1400) empty.push(i); });
    if (!empty.length) return;
    const idx = empty[rand(0, empty.length-1)];
    let q, ans, opts;
    if (gameState.cat === 'chinese') {
        const d = WHACK_CN_WORDS[rand(0, WHACK_CN_WORDS.length-1)];
        q = `找出汉字：${d.t}`;
        opts = shuffle([...d.w]);
        ans = d.t;
    } else if (gameState.cat === 'english') {
        const d = WHACK_EN_WORDS[rand(0, WHACK_EN_WORDS.length-1)];
        q = `中文：${d.t}`;
        opts = shuffle([...d.w]);
        ans = d.w[0];
    } else {
        const p = genRaceQuestion();
        q = `${p.q} = ?`;
        const r = new Set([p.a]);
        let rg = 0;
        while (r.size < 4 && rg++ < 200) r.add(p.a + rand(-6, 6));
        // 兜底：还不够就直接用绝对偏移
        let pad = 1;
        while (r.size < 4) { r.add(p.a + pad); pad = pad > 0 ? -pad : -pad + 1; }
        opts = shuffle([...r].map(x => x.toString()));
        ans = p.a.toString();
    }
    const correctHole = rand(0, 8);
    // 保证 correctHole 上放正确答案，其他随机
    const usedOpts = new Set([ans]);
    gameState.holes.forEach((_, i) => {
        if (i === correctHole) {
            gameState.holes[i] = { text: ans, correct: true, t: Date.now() };
        } else {
            let fake;
            const pool = opts.filter(o => o !== ans && !usedOpts.has(o));
            if (pool.length) fake = pool[rand(0, pool.length-1)];
            else { fake = (parseInt(ans)||0) + rand(-20,20); fake = fake.toString(); usedOpts.add(fake); }
            gameState.holes[i] = { text: fake, correct: false, t: Date.now() };
        }
    });
    gameState.q = q;
    gameState.ans = ans;
}
