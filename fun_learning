function startMemory(cat) {
    const pairs = MEMORY_DATA[cat].slice(0, 6);
    const cards = shuffle(pairs.flatMap((p, i) => [
        { pair: i, text: p[0] }, { pair: i, text: p[1] }
    ]));
    gameState = { type:'memory', cat, cards, flip1:null, flip2:null, matched:new Set(), moves:0, lock:false, start:Date.now() };
    renderMemory();
}
function renderMemory() {
    const container = document.getElementById('gameModalBody');
    const catName = {chinese:'语文成语', english:'英语单词'}[gameState.cat];
    const cardsHtml = gameState.cards.map((c, i) => {
        const flipped = (gameState.flip1===i || gameState.flip2===i || gameState.matched.has(i));
        const matched = gameState.matched.has(i);
        return `<div class="memory-card ${flipped?'flipped':''} ${matched?'matched':''}" onclick="memoryClick(${i})">
            <div class="memory-face memory-front">❓</div>
            <div class="memory-face memory-back">${c.text}</div>
        </div>`;
    }).join('');
    container.innerHTML = `
        <div style="width:100%">
            <div class="game-title">${catName} · 记忆翻翻乐</div>
            <div style="display:flex;justify-content:center;gap:30px;margin-bottom:10px;font-size:15px;color:#555;flex-wrap:wrap">
                <span>🎯 步数：<b>${gameState.moves}</b></span>
                <span>✅ 已配对：<b>${gameState.matched.size/2} / ${gameState.cards.length/2}</b></span>
            </div>
            <div class="memory-grid">${cardsHtml}</div>
            <div style="text-align:center;margin-top:15px">
                <button class="btn btn-warning" onclick="startMemory('${gameState.cat}')">🔄 重玩</button>
                <button class="btn btn-info" onclick="closeGameModal()">🏠 大厅</button>
            </div>
        </div>
    `;
}
function memoryClick(i) {
    if (gameState.lock || gameState.matched.has(i)) return;
    if (gameState.flip1===i) return;
    if (gameState.flip1 === null) { gameState.flip1 = i; renderMemory(); return; }
    gameState.flip2 = i;
    gameState.moves++;
    const c1 = gameState.cards[gameState.flip1];
    const c2 = gameState.cards[gameState.flip2];
    renderMemory();
    gameState.lock = true;
    if (c1.pair === c2.pair && gameState.flip1 !== gameState.flip2) {
        setTimeout(() => {
            gameState.matched.add(gameState.flip1);
            gameState.matched.add(gameState.flip2);
            gameState.flip1 = gameState.flip2 = null;
            gameState.lock = false;
            renderMemory();
            if (gameState.matched.size === gameState.cards.length) {
                const sec = Math.round((Date.now()-gameState.start)/1000);
                const stars = Math.min(5, Math.max(1, 6 - Math.floor(gameState.moves / 4)));
                finishGameResult('🎉 全部配对完成！', '🏆', [
                    `🎯 使用步数：<b>${gameState.moves}</b> 步`,
                    `⏱️ 用时：<b>${sec}</b> 秒`,
                    `📚 共 <b>${gameState.cards.length/2}</b> 对卡片`,
                ], stars);
            }
        }, 500);
    } else {
        setTimeout(() => {
            gameState.flip1 = gameState.flip2 = null;
            gameState.lock = false;
            renderMemory();
        }, 900);
