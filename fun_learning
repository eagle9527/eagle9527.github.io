function gradeIdx_fix() {
    return Math.min(2, appState.currentGrade <= 2 ? 0 : appState.currentGrade <= 4 ? 1 : 2);
}
function onTypingInput(e) {
    const val = e.target.value;
    const target = gameState.words[gameState.i];
    gameState.input = val;
    gameState.typedChars = val.length;
    if (val.length >= target.length) {
        // 判断完成
        if (val === target) gameState.correct++;
        else gameState.wrong++;
        gameState.i++;
        gameState.input = '';
        gameState.typedChars = 0;
        if (gameState.i >= gameState.words.length) {
            clearInterval(gameState._timer);
            finishTyping();
            return;
        }
    }
