    // 2. 根据专题名+年级智能生成10道题
    const topic = (MATH_TOPICS[grade]||[]).find(t => t.id === topicId);
    const topicName = topic ? topic.name : '';
    const n = 10, qs = [];
    // ---------- 工具函数顺序：_opt → _mcq → _fin → qBank return（严格依赖链） ----------
    // _opt：给数字型正确答案生成4个不重复的干扰选项
    const _opt = (correctAns, rangeMin, rangeMax) => {
        const s = new Set([correctAns]);
        let guard = 0;
        // 确保生成范围足够大，如果原范围小则强制扩大
        const span = Math.abs(rangeMax - rangeMin) + 1;
        const rMin = span >= 6 ? rangeMin : Math.min(rangeMin, -6);
        const rMax = span >= 6 ? rangeMax : Math.max(rangeMax, 8);
        while (s.size < 4 && guard++ < 200) {
            let v = correctAns + rand(rMin, rMax);
            if (v < 0) v = Math.abs(v) + 1;
            s.add(v);
        }
        // 超出循环仍不满时，兜底填充保证4个不重复
        let extra = 1;
        while (s.size < 4) {
            let v = correctAns + extra;
            if (v < 0) v = Math.abs(v) + 1;
            s.add(v);
            extra++;
        }
        return shuffle([...s]);
    };
    // _mcq：双模式（数值干扰项 或 直接传字符串选项数组）造一题
    const _mcq = (q, correct, expl, minDiffOrOpts, maxDiffOrExplain) => {
        let opts, explain;
        if (Array.isArray(minDiffOrOpts)) {
            opts = [...minDiffOrOpts];
            explain = maxDiffOrExplain != null ? maxDiffOrExplain : (typeof expl === 'string' ? expl : '');
        } else {
            opts = _opt(correct, minDiffOrOpts, maxDiffOrExplain);
            explain = expl;
        }
        const shuffled = shuffle(opts.map(x => (typeof x === 'number' ? Number(x.toFixed ? Number(x.toFixed(4)) : x) : x)));
        const normalized = shuffled.map(x => typeof x === 'number' ? Number(x.toFixed ? Number(x.toFixed(4)) : x) : String(x).trim());
        const corNum = typeof correct === 'number' ? Number(correct.toFixed ? Number(correct.toFixed(4)) : correct) : null;
        const corStr = String(correct).trim();
        let idx = normalized.findIndex((v, i) => {
            if (corNum !== null && typeof v === 'number') return Math.abs(v - corNum) < 1e-9;
            return String(v).trim() === corStr;
        });
        if (idx < 0) idx = 0;
        return { q, options: shuffled.map(String), correct: idx, explain };
    };
    // _fin：统一出口工厂（去重题干 → 不足10条用口算兜底 → correct越界强制=0）
    const _fin = (arr) => {
        const seen = new Map();
        const uniq = [];
        for (const q of arr) {
            if (!q || typeof q !== 'object') continue; // 跳过undefined/null/非对象（闭包return异常时）
            const k = (q.q||'').trim();
            if (k && !seen.has(k) && uniq.length < 10) { seen.set(k, true); uniq.push(q); }
        }
        let guard = 0;
        while (uniq.length < 10 && guard < 200) {
            guard++;
            const a=rand(2,99), b=rand(2,9);
            const pick = rand(0,3);
            let nq;
            if (pick===0) nq = _mcq(`${a}+${b}=?`,a+b,`${a}+${b}=${a+b}`,-10,10);
            else if (pick===1) { const x=Math.max(a,b), y=Math.min(a,b); nq = _mcq(`${x}-${y}=?`,x-y,`${x}-${y}=${x-y}`,-10,10); }
            else if (pick===2) nq = _mcq(`${a}×${b}=?`,a*b,`${a}×${b}=${a*b}`,-30,30);
            else { const x=a*b, d=b; nq = _mcq(`${x}÷${d}=?`,a,`${d}×${a}=${x} → 商${a}`,-5,5); }
            const nk = (nq.q||'').trim() + '_' + uniq.length;
            if (!seen.has(nk)) { seen.set(nk,true); uniq.push(nq); }
        }
        // 最后再校验correct，避免-1越界
        return uniq.slice(0, 10).map(q => {
            if (!q || !Array.isArray(q.options)) return q;
            if (typeof q.correct !== 'number' || q.correct < 0 || q.correct >= q.options.length) {
                return {...q, correct: 0};
            }
            return q;
        });
    };
    // qBank return：支持「固定对象数组」和「闭包函数数组」两种格式
    // 闭包数组元素格式：() => ({q,options,correct,explain})，调用后生成具体题目，确保每次进专题数值/干扰项不重复
    if (qBank[topicId]) {
        const raw = qBank[topicId];
        // 展开闭包数组，然后 shuffle 打乱顺序（否则15闭包池永远前10题固定），再送_fin去重+补位+兜底
        const expanded = shuffle(raw.map(item => typeof item === 'function' ? item() : item));
        return _fin(expanded);
    }

    // --- 加减法口算类 (占比最高，所有年级都有) ---
    if (/加减法|加.*减|10以内|20以内|100以内|整十|连加|连减|混合运算|几百几十|三位数加减|万以内/.test(topicName)) {
        let rangeA=[1,10], rangeB=[1,10];
        if (/10以内/.test(topicName)) { rangeA=[1,10]; rangeB=[1,10]; }
        else if (/20以内.*退位|20以内.*进位|20以内/.test(topicName)) { rangeA=[5,18]; rangeB=[2,15]; }
        else if (/整十/.test(topicName)) { rangeA=[1,9]; rangeB=[1,9]; }
        else if (/100以内|两位数|两位.*进位|两位.*退位/.test(topicName)) { rangeA=[10,80]; rangeB=[10,70]; }
        else if (/几百|三位数|万以内/.test(topicName)) { rangeA=[100,800]; rangeB=[100,800]; }
        else if (/连加|连减|加减混合|混合运算/.test(topicName)) { rangeA=[1,80]; rangeB=[1,50]; }
        for (let i=0; i<n; i++) {
            const op = Math.random();
            if (op < 0.45) {
                let a = rand(rangeA[0],rangeA[1]), b = rand(rangeB[0],rangeB[1]);
                if (/整十/.test(topicName)) { a*=10; b*=10; }
                const c = a + b;
                qs.push(_mcq(`${a} + ${b} = ?`, c, `${a}+${b}=${c}`, -10, 10));
            } else if (op < 0.85) {
                let a = rand(rangeA[0],rangeA[1]), b = rand(rangeB[0],rangeB[1]);
                if (/整十/.test(topicName)) { a*=10; b*=10; }
                if (a < b) [a,b] = [b,a];
                const c = a - b;
                qs.push(_mcq(`${a} - ${b} = ?`, c, `${a}-${b}=${c}`, -10, 10));
            } else {
                // 连加连减或两步混合
                let a=rand(5,50), b=rand(2,30), c=rand(2,20);
                const sign1 = Math.random()<0.5?'+' : '-';
                const sign2 = Math.random()<0.5?'+' : '-';
                let r = a + (sign1==='+'?b:-b) + (sign2==='+'?c:-c);
                if (r<0) { r=a+b+c; qs.push(_mcq(`${a}+${b}+${c}=?`,r,`${a}+${b}+${c}=${r}`,-15,15)); }
                else qs.push(_mcq(`${a} ${sign1} ${b} ${sign2} ${c} = ?`,r,`按从左到右顺序计算得${r}`,-15,15));
            }
        }
        return _fin(qs);
    }
    // --- 乘法 ---
