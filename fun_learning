    // 2.2 词汇题池（话题·数字/颜色/家庭/动物/食物/文具/身体/季节/天气/节日/职业/交通）
    const vocabQs = [
        () => ({q:'"apple"是什么意思？',options:['香蕉','苹果','橘子','梨'],correct:1,explain:'apple=苹果；banana香蕉；orange橘子；pear梨。'}),
        () => ({q:'"dog"是什么动物？',options:['猫','狗','猪','牛'],correct:1,explain:'dog=狗；cat猫；pig猪；cow牛。'}),
        () => ({q:'"panda"指的是？',options:['老虎','狮子','熊猫','大象'],correct:2,explain:'panda=大熊猫，中国国宝，以竹子为食。'}),
        () => ({q:'"I have a new ____."（我有一个新书包）',options:['pencil','bag','ruler','book'],correct:1,explain:'bag=包/书包；schoolbag=书包；pencil铅笔；ruler尺子；book书。'}),
        () => ({q:'"My ____ hurts."（我牙疼）',options:['hand','tooth','foot','ear'],correct:1,explain:'tooth=牙齿（复数teeth）；牙疼=toothache。'}),
        () => ({q:'"Spring, summer, autumn, winter"是？',options:['星期','月份','四季','天气'],correct:2,explain:'春夏秋冬=four seasons四季；spring春、summer夏、autumn/fall秋、winter冬。'}),
        () => ({q:'"It is ____ today."（今天下雨）',options:['sunny','rainy','snowy','windy'],correct:1,explain:'rainy=下雨的；sunny晴朗；snowy下雪；windy有风。'}),
        () => ({q:'"Teachers\' Day"在中国是哪一天？',options:['6月1日','9月10日','10月1日','1月1日'],correct:1,explain:'Teachers\' Day=教师节，中国每年9月10日。'}),
        () => ({q:'医生用英语说？',options:['teacher','farmer','doctor','driver'],correct:2,explain:'doctor=医生；teacher老师；farmer农民；driver司机。'}),
        () => ({q:'"by plane"的意思是？',options:['坐公交车','坐地铁','坐飞机','走路'],correct:2,explain:'by + 交通工具=乘坐…；by plane=by air坐飞机。'}),
    ];

    // 2.3 情景交际·对话题池
    const dialogueQs = [
        () => ({q:'别人说"Happy birthday to you!"，你回答：',options:['You are welcome.','Thank you.','OK.','Good.'],correct:1,explain:'对任何祝福都应该道谢：Thank you! 或 Thanks!'}),
        () => ({q:'你想问别人多大了，用英语说：',options:['How are you?','How old are you?','What is your name?','Where are you?'],correct:1,explain:'How old are you? 问年龄；How are you?问身体。'}),
        () => ({q:'当你想知道时间，你问：',options:['What time is it?','What is it?','How much is it?','Where is the clock?'],correct:0,explain:'问时间：What time is it? = What is the time? 回答：It is + 时间。'}),
        () => ({q:'"Can I help you?" 常见于什么场景？',options:['学校门口','商店/餐厅','医院住院','大街上'],correct:1,explain:'Can I help you?=需要帮忙吗/您想买点什么？是服务员店员的标准开场白。'}),
        () => ({q:'打电话时你想说"我是Tom"，英语是：',options:['I am Tom.','This is Tom (speaking).','My name is Tom.','That is Tom.'],correct:1,explain:'电话用语不用I am… 而用 This is … (speaking). 表"我是…"。'}),
        () => ({q:'你问同学"这支笔是你的吗？"：',options:['Is this your pen?','This is your pen.','Are you a pen?','I have a pen.'],correct:0,explain:'一般疑问句：Is this your + 名词? 回答 Yes, it is. / No, it isn\'t.'}),
        () => ({q:'你想表达"我也一样"，简短地说：',options:['I too.','Me too.','I also.','Me neither.'],correct:1,explain:'Me too.用于肯定句后的"我也一样"；否定"我也不"用Me neither.'}),
        () => ({q:'别人祝你"Good luck!"你回答：',options:['OK.','Thank you.','Good luck, too.','Sorry.'],correct:1,explain:'对别人的祝福Good luck（祝你好运），要礼貌道谢 Thank you!'}),
        () => ({q:'你想借同桌的橡皮，最礼貌说：',options:['Give me your eraser.','Excuse me, may I use your eraser?','I want an eraser.','Take your eraser.'],correct:1,explain:'请求许可要用May I …?（我可以…吗？）+ please，更礼貌得体。'}),
        () => ({q:'吃饭前主人可以对客人说？',options:['Help yourself.','Eat.','I am hungry.','Let\'s go.'],correct:0,explain:'Help yourself. = 请随便吃/别客气，是款待客人的常用口语。'}),
    ];

    // 2.4 语法题池（时态/比较级/There be/情态动词/冠词/介词/代词）
    const grammarQs = [
        () => ({q:'There ____ a book on the desk.',options:['is','are','am','be'],correct:0,explain:'There be句型就近原则：a book是单数，所以用is。'}),
        () => ({q:'There ____ some apples in the box.',options:['is','are','be','am'],correct:1,explain:'some apples是复数，There be用are。'}),
        () => ({q:'"Tom is ____ (tall) than Jerry."',options:['tall','taller','tallest','more tall'],correct:1,explain:'than（比）=比较级标志；tall单音节直接加er→taller。'}),
        () => ({q:'形容词最高级前要加？',options:['a','an','the','不加'],correct:2,explain:'最高级的结构：the + 形容词最高级 + 范围（in/of…）。'}),
        () => ({q:'"Can you swim? - Yes, I ____."',options:['can','am','do','will'],correct:0,explain:'情态动词Can问→can答：Yes, I can. / No, I can\'t.'}),
        () => ({q:'"I ____ a student. My name ____ Tom."',options:['am; is','is; am','are; is','am; are'],correct:0,explain:'be动词口诀：I用am，you用are，is连着he/she/it，单数不可数用is，复数一律都用are。'}),
        () => ({q:'____ book on the desk is mine.（桌子上那本书是我的）',options:['A','An','The','不填'],correct:2,explain:'特指"桌子上那本书"，不是任意一本，要用定冠词The。'}),
        () => ({q:'"We go to school ____ Monday ____ Friday."（我们周一到周五上学）',options:['on; to','from; to','in; and','at; on'],correct:1,explain:'from … to …=从…到…（表时间或地点）。'}),
        () => ({q:'"This is my book. That is ____ (你的)."',options:['you','your','yours','yourself'],correct:2,explain:'your是形容词性物主代词后接名词；yours是名词性物主代词，=your book，后面不接名词。'}),
        () => ({q:'"It\'s time ____ dinner."（该吃晚饭了）',options:['to','for','of','at'],correct:1,explain:'固定搭配：It is time for + 名词；It is time to + 动词原形。'}),
    ];

    // 2.5 句型转换·翻译题池
    const sentenceQs = [
        () => ({q:'"I am a teacher."变一般疑问句：',options:['Are you a teacher?','Is you a teacher?','Am you a teacher?','Do you a teacher?'],correct:0,explain:'I am …变一般疑问句习惯改人称+be动词：Are you …?'}),
        () => ({q:'"She likes music."变否定句：',options:['She don\'t like music.','She doesn\'t like music.','She not like music.','She isn\'t like music.'],correct:1,explain:'三单一般现在时变否定：doesn\'t+动词原形；likes→like。'}),
        () => ({q:'"What\'s this in English?"的正确回答是：',options:['This is a pen.','It is a pen.','That is a pen.','I am a pen.'],correct:1,explain:'答句用It代替this/that，避免重复。'}),
        () => ({q:'"I have two apples."对划线two提问：',options:['How much apples do you have?','How many apples do you have?','What apples do you have?','Where are apples?'],correct:1,explain:'对可数名词数量提问用How many + 复数名词；对不可数/价格用How much。'}),
        () => ({q:'把"他骑自行车去上学"翻译成英语：',options:['He go to school by bike.','He goes to school by bike.','He by bike go to school.','He on bike to school.'],correct:1,explain:'主语He三单→goes；方式状语by bike放句末。句型：主语 + 谓语 + 宾语 + 方式 + 地点 + 时间。'}),
        () => ({q:'"How much is the T-shirt?"问的是？',options:['T恤有多少件','T恤的颜色','T恤的价格','T恤的尺寸'],correct:2,explain:'How much + be动词 + 单数主语？=问某物多少钱。'}),
        () => ({q:'"Let\'s go to the park, ____?"（反义疑问句）',options:['don\'t we','shall we','will you','do we'],correct:1,explain:'Let\'s（包括对方）的反义疑问句固定用shall we?；Let us（不包括对方）用will you?。'}),
        () => ({q:'"____ beautiful the flower is!"（这花真漂亮啊！）',options:['What','How','What a','How a'],correct:1,explain:'感叹句：How + 形容词/副词 + 主谓…！What + 名词短语 + 主谓…！'}),
        () => ({q:'"He said that he ____ come tomorrow."（他说他明天会来）',options:['will','would','shall','is'],correct:1,explain:'主句said是过去时，宾语从句时态倒退：will→would（过去将来时）。'}),
        () => ({q:'"I don\'t know ____ he will come or not."',options:['that','whether','what','how'],correct:1,explain:'whether … or not 是固定搭配（是否…），不能用that替换。'}),
    ];

    // 2.6 阅读·写作·话题综合题池
    const readWriteQs = [
        () => ({q:'做英语阅读理解"根据短文回答问题"，最可靠的方法是？',options:['凭感觉猜','在原文中找相关句子定位再判断','直接看选项选最长的','跳过不做'],correct:1,explain:'先看题干关键词→回原文定位→对照原句判断，正确率最高。'}),
        () => ({q:'英语书信的开头称呼顶格写，后面加？',options:['逗号','句号','冒号','感叹号'],correct:0,explain:'英语书信称呼顶格 + 逗号（美式有时用冒号），和中文冒号略有不同。'}),
        () => ({q:'写英语作文"My Best Friend"最合适的时态是？',options:['一般现在时','一般过去时','一般将来时','现在进行时'],correct:0,explain:'介绍人物、日常情况、长相性格爱好，通常用一般现在时。'}),
        () => ({q:'英语日记格式通常首先写？',options:['星期+日期+天气','只写日期','只写天气','直接写正文'],correct:0,explain:'英语日记第一行一般是星期+日期（右上角）+天气，然后空两格写正文。'}),
        () => ({q:'"My School Day"（我的上学日）作文用什么顺序最合适？',options:['时间顺序（从早到晚）','空间顺序','由远及近','由因到果'],correct:0,explain:'一天的事按时间线写（get up→breakfast→school→lunch→…→go to bed）最清晰。'}),
        () => ({q:'英文写作中，句子之间的连接词"First, Next, Then, Finally"表示？',options:['转折','顺序步骤','因果','让步'],correct:1,explain:'First/Next/Then/Finally=首先/接下来/然后/最后，用来表示做事的先后顺序。'}),
        () => ({q:'自我介绍（My Self Introduction）一般不必包含？',options:['姓名年龄','爱好特长','银行卡密码','理想梦想'],correct:2,explain:'自我介绍常写：姓名、年龄、学校、家庭、爱好、特长、梦想；隐私信息不要写。'}),
        () => ({q:'"My Plan for the Summer Holiday"（我的暑假计划）用什么时态？',options:['一般现在时','一般过去时','一般将来时/be going to','现在进行时'],correct:2,explain:'计划=将来，用will + 动词原形 或 am/is/are going to + 动词原形。'}),
        () => ({q:'写作文"An Unforgettable Trip"（一次难忘的旅行）应该用什么时态？',options:['一般现在时','一般过去时','一般将来时','现在进行时'],correct:1,explain:'已经发生过的旅行经历，自然用一般过去时。'}),
        () => ({q:'英语写数字"一百二十三"是？',options:['one hundred and twenty-three','one hundred twenty three','a hundred twenty-three','one hundreds and twenty three'],correct:0,explain:'英式百和十之间加and；20~99几十几中间要有连字符-；hundred前面有具体数字不加s。'}),
    ];

    // ===================== 3. 正则路由：从ENGLISH_TOPICS中取name+desc匹配 =====================
    let nameAndDesc = '';
    const gradeList = ENGLISH_TOPICS[grade] || [];
    for (const t of gradeList) { if (t.id === topicId) { nameAndDesc = t.name + ' ' + t.desc; break; } }
    if (!nameAndDesc) {
        outer: for (const gg in ENGLISH_TOPICS) for (const t of ENGLISH_TOPICS[gg]) {
            if (t.id === topicId) { nameAndDesc = t.name + ' ' + t.desc; break outer; }
        }
    }

    let pool;
    if (/字母|ABC|abc|字母发音|音标|元音|辅音|大小写|拼写规则|首字母|a|an|the定冠词/.test(nameAndDesc)) {
        pool = letterQs;
    } else if (/词汇|单词|数字|颜色|家庭|动物|食物|水果|文具|身体部位|季节|月份|星期|天气|服饰|交通|职业|节日|地点|教室|房间|农场|公园|爱好|运动|乐器|国家|语言|标志|指示代词|人称代词|物主代词|反身代词|量词|名词单复数|所有格/.test(nameAndDesc)) {
        pool = vocabQs;
    } else if (/问候|日常交际|礼貌用语|打电话|购物|问路|看病|饭店点餐|图书馆|失物招领|建议提建议|邀请|告别|祝福|道歉|道谢|自我介绍|介绍他人|拜访|情景|对话|口语|topic|话题|talk|say|tell|speak|tell story|duty report/.test(nameAndDesc)) {
        pool = dialogueQs;
    } else if (/时态|一般现在|三单|现在进行|一般过去|一般将来|过去进行|现在完成|比较级|最高级|There be|情态动词|can|may|must|should|冠词|介词|in|on|at|by|for|from|to|with|代词|名词|数词|冠词|连词|and|but|or|so|because|if|when|while|被动|定语从句|宾语从句|状语从句|主谓一致|非谓语|doing|done|to do|祈使句|感叹句|反义疑问/.test(nameAndDesc)) {
        pool = grammarQs;
    } else if (/句型|对划线|一般疑问|特殊疑问|选择疑问|反义疑问|否定句|同义句|翻译|中英互译|连词成句|改错|句子排序|合并句子|扩句|缩句/.test(nameAndDesc)) {
        pool = sentenceQs;
    } else {
        // 阅读·写作·综合·复习
        pool = readWriteQs;
    }

    // ===================== 4. 最终组合：手写→池抽10题（pool元素是闭包，需调用后展开） =====================
    if (qBank[topicId]) return qBank[topicId];
    const shuffled = [...pool].sort(() => Math.random() - 0.5).map(fn => typeof fn === 'function' ? fn() : fn);
    return shuffled.slice(0, 10);
}

