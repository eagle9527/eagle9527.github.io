let currentSession = null;
function openStudyModal(subject, topic) {
    let questions;
    if (subject === 'chinese') questions = generateChineseQuestions(topic.id, appState.currentGrade);
    else if (subject === 'math') questions = generateMathQuestions(topic.id, appState.currentGrade);
    else questions = generateEnglishQuestions(topic.id, appState.currentGrade);

    currentSession = {
        subject, topic,
        questions: questions,
        currentIndex: 0,
        answers: new Array(questions.length).fill(null), // null / {chosen, correct}
        score: 0,
    };

    const headerMap = { chinese: 'chinese', math: 'math', english: 'english' };
    document.getElementById('modalHeader').className = 'modal-header ' + headerMap[subject];
    document.getElementById('modalTitle').textContent = `${topic.icon} ${topic.name}`;
    document.getElementById('studyModal').classList.add('show');

    renderQuestion();
}

function renderQuestion() {
    const s = currentSession;
    const q = s.questions[s.currentIndex];
    const ans = s.answers[s.currentIndex];
    const modalBody = document.getElementById('modalBody');

    const optionsHtml = q.options.map((opt, i) => {
        let cls = 'option-btn';
        let disabled = '';
        if (ans) {
            disabled = 'disabled';
            if (i === q.correct) cls += ' correct';
            else if (i === ans.chosen) cls += ' wrong';
        }
        const letter = ['A','B','C','D'][i];
        return `<button class="${cls}" data-index="${i}" ${disabled}>
            <strong style="margin-right:8px">${letter}.</strong>${opt}
        </button>`;
    }).join('');

    const explainHtml = ans ? `<div class="explanation show">💡 <strong>解析：</strong>${q.explain}</div>`
                            : `<div class="explanation"></div>`;

    modalBody.innerHTML = `
        <div class="question-area">
            <div class="question-meta">
                <span>📌 第 ${s.currentIndex + 1} 题 / 共 ${s.questions.length} 题</span>
                <span>📚 ${s.subject === 'chinese' ? '语文' : s.subject === 'math' ? '数学' : '英语'}</span>
            </div>
            <div class="question-text">${q.q}</div>
            <div class="options-grid">${optionsHtml}</div>
            ${explainHtml}
        </div>
    `;

    // 绑定选项
    modalBody.querySelectorAll('.option-btn').forEach(btn => {
        btn.addEventListener('click', () => onAnswer(parseInt(btn.dataset.index)));
    });

    // 导航
    document.getElementById('questionIndicator').textContent = `${s.currentIndex + 1} / ${s.questions.length}`;
    document.getElementById('prevQuestion').disabled = s.currentIndex === 0;
    const nextBtn = document.getElementById('nextQuestion');
    if (s.currentIndex === s.questions.length - 1) {
        const allAnswered = s.answers.every(a => a);
        nextBtn.textContent = allAnswered ? '🎉 完成测试' : '下一题 ➡';
        nextBtn.disabled = !allAnswered;
    } else {
        nextBtn.textContent = '下一题 ➡';
        nextBtn.disabled = false;
    }

    // 计算实时分数
    let correctCount = s.answers.filter(a => a && a.correct).length;
    let answeredCount = s.answers.filter(a => a).length;
    let realScore = answeredCount > 0 ? Math.round(correctCount / answeredCount * 100) : 0;
    document.getElementById('scoreDisplay').textContent = '⭐ ' + realScore;
}

function onAnswer(chosen) {
    const s = currentSession;
    if (s.answers[s.currentIndex]) return;
    const q = s.questions[s.currentIndex];
    const correct = chosen === q.correct;
    s.answers[s.currentIndex] = { chosen, correct };
    renderQuestion();
}

function closeStudyModal() {
    document.getElementById('studyModal').classList.remove('show');
    currentSession = null;
}

function submitQuiz() {
    const s = currentSession;
    const correctCount = s.answers.filter(a => a && a.correct).length;
    const total = s.questions.length;
    const score = Math.round(correctCount / total * 100);

    // 保存成绩
    appState.completed[s.topic.id] = {
        score, answered: correctCount, total,
        time: Date.now(),
    };

    // 达到60分以上，加星星奖励
    if (score >= 60) {
        let stars = 1;
        if (score >= 80) stars = 2;
        if (score >= 100) stars = 3;
        appState.stars += stars;
        showReward(score, stars);
    } else {
        alert(`本次得分 ${score}分（答对 ${correctCount}/${total}）\n💪 再接再厉，加油！`);
    }

    // 最近学习
    appState.recent.unshift({ subject: s.subject, topicName: s.topic.name, score, time: Date.now() });
    appState.recent = appState.recent.slice(0, 10);

    saveState();
    closeStudyModal();
    renderAllSubjects();
}

function showReward(score, stars) {
    let emoji = '🎉';
    let title = '太棒了！';
    let msg = '';
    if (score === 100) {
        emoji = '🏆'; title = '满分通过！';
        msg = '你真是个小学霸！全部题目都答对了，太厉害了！';
    } else if (score >= 90) {
        emoji = '🌟'; title = '优秀！';
        msg = '非常棒！继续保持，你离满分就差一点点啦！';
    } else if (score >= 80) {
        emoji = '😊'; title = '做得很好！';
        msg = '表现不错，巩固一下，下次争取满分！';
    } else {
        emoji = '💪'; title = '合格啦！';
        msg = '及格啦！多多练习，你会越来越棒的！';
    }
    document.getElementById('rewardEmoji').textContent = emoji;
    document.getElementById('rewardTitle').textContent = title;
    document.getElementById('rewardStars').textContent = '⭐'.repeat(stars) + ' 获得 ' + stars + ' 颗星';
    document.getElementById('rewardMessage').textContent = msg + `\n得分：${score}分`;
    document.getElementById('rewardModal').classList.add('show');
}

