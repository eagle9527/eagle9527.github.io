function startJielong() {
    const data = CHENGYU_JIELONG[rand(0, CHENGYU_JIELONG.length-1)];
    const all = [data.first, ...data.chain];
    // 生成 4 题：每题给 4 选项，其中一个接得上
    const qs = [];
    for (let i=0;i<Math.min(4, data.chain.length);i++) {
        const prev = all[i];
        const answer = data.chain[i];
        const lastCh = prev[prev.length-1];
        // 生成3个干扰
        const fakes = new Set();
        const allWords = [...CHENGYU_JIELONG.flatMap(c => c.chain)];
        let guard2 = 0;
        while (fakes.size < 3 && guard2++ < 500) {
            const cy = allWords[rand(0, allWords.length - 1)];
            if (cy !== answer && !fakes.has(cy)) fakes.add(cy);
        }
        // 兜底：不够的话从池子里顺序找
        if (fakes.size < 3) {
            for (const w of allWords) { if (w !== answer && !fakes.has(w)) { fakes.add(w); if (fakes.size >= 3) break; } }
        }
        // 最后兜底（极端情况）：重复答案不会出现，保证选项数满足要求
        let fallbackIdx = 0;
        while (fakes.size < 3) { fakes.add(answer + '__干扰' + (++fallbackIdx)); }
        const opts = shuffle([answer, ...fakes]);
        qs.push({prev, answer, opts, full:`${prev} → ${answer}`});
    }
    gameState = { type:'jielong', qs, i:0, correct:0, picked:null };
    renderJielong();
}
function renderJielong() {
    const container = document.getElementById('gameModalBody');
    const q = gameState.qs[gameState.i];
    const optsHtml = q.opts.map((o, idx) => {
        let cls = 'btn-primary';
        if (gameState.picked != null) {
            if (idx === q.opts.indexOf(q.answer)) cls = 'btn-success';
            else if (idx === gameState.picked) cls = 'btn-danger';
        }
        return `<button class="btn ${cls}" ${gameState.picked!=null?'disabled':''} onclick="jielongPick(${idx})" style="font-size:16px;padding:12px 20px;margin:6px">${o}</button>`;
    }).join('');
    container.innerHTML = `
        <div style="max-width:600px;margin:0 auto;text-align:center">
            <div class="game-title">🐉 成语接龙大师</div>
            <div style="font-size:15px;color:#666;margin-bottom:12px">
                第 ${gameState.i+1} / ${gameState.qs.length} 题 · 找到能接在后面的成语
            </div>
            <div style="background:linear-gradient(135deg,#fef3c7,#fde68a);padding:18px;border-radius:16px;font-size:22px;font-weight:bold;color:#92400e;margin:15px 0">
                ${q.prev} → <span style="color:#dc2626">❓ 接哪个成语？</span>
            </div>
            <div style="margin:20px 0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px">
                ${optsHtml}
            </div>
            ${gameState.picked != null ? `
                <div style="margin-top:15px;padding:15px;border-radius:12px;background:${gameState.picked===q.opts.indexOf(q.answer)?'#d4edda':'#f8d7da'};color:${gameState.picked===q.opts.indexOf(q.answer)?'#155724':'#721c24'};text-align:left">
                    <b>${gameState.picked===q.opts.indexOf(q.answer)?'✅ 接对了！':'❌ 接错了'}</b><br>
                    📖 正确接龙：<b>${q.full}</b>
                </div>
                <div style="margin-top:20px">
                    <button class="btn btn-primary" onclick="jielongNext()" style="font-size:16px;padding:12px 24px">
                        ${gameState.i===gameState.qs.length-1 ? '🏆 查看结果' : '➡ 下一题'}
                    </button>
                </div>
            ` : ''}
            <div style="margin-top:20px">
                <button class="btn btn-info" onclick="closeGameModal()">🏠 返回大厅</button>
            </div>
        </div>
    `;
}
function jielongPick(i) {
    if (gameState.picked != null) return;
    gameState.picked = i;
    const q = gameState.qs[gameState.i];
    if (q.opts[i] === q.answer) gameState.correct++;
    renderJielong();
}
function jielongNext() {
    gameState.picked = null;
    if (gameState.i >= gameState.qs.length - 1) {
        const stars = calcStars(gameState.correct, gameState.qs.length, gameState.correct===gameState.qs.length);
        finishGameResult('🐉 成语接龙结束！', stars>=3 ? '🏆' : '🎉', [
            `✅ 答对：<b style="color:#27ae60">${gameState.correct}</b> 题`,
            `❌ 答错：<b style="color:#e74c3c">${gameState.qs.length - gameState.correct}</b> 题`,
