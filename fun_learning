            if (t===0) { const out=rand(40,50), total=rand(100,200); qs.push(_mcq(`发芽实验${total}粒，发芽${out}粒，发芽率？%（取整）`, Math.round(out/total*100), `发芽率=发芽数÷总数×100%=${Math.round(out/total*100)}%`, -10, 10)); }
            else if (t===1) { qs.push({q:'出勤率（ ）100%（填大于/小于/小于等于/等于）',options:['>','<','≤（小于等于）','='],correct:2,explain:'出勤人数≤总人数 → 出勤率≤100%（同理出油率/出粉率也常<100%）'}); }
            else if (t===2) qs.push({q:'增长率（ ）100%',options:['可以大于','一定小于','只能等于','不能超过'],correct:0,explain:'增长率可以>100%（如增长到原来的2倍=增长率100%；3倍=200%）'});
            else if (t===3) { const ttl=rand(40,60), att=rand(38,ttl); qs.push(_mcq(`全班${ttl}人今天出勤${att}人，出勤率？%(取整)`, Math.round(att/ttl*100), `出勤率=${att}/${ttl}×100%≈${Math.round(att/ttl*100)}%`, -5, 5)); }
            else qs.push({q:'出油率是指出油量占油料总质量的百分之几，一般（ ）',options:['>100%','<100%','=100%','可以随便'],correct:1,explain:'不可能榨出的油比原料还重 → 出油率<100%'});
        }
        return _fin(qs);
    }
    // ===================== 年级匹配兜底10题（仅在所有精确分支未命中时使用） =====================
    // 注：所有155个数学专题均已在上方 qBank + 40+精确正则分支 覆盖，此处仅作为极端防御性兜底
    for (let i=0; i<n; i++) {
        const r = Math.random();
        if (grade <= 2) {
            // G1-2：仅加减法口算，禁止出现乘除
            let a=rand(1,99), b=rand(1,99);
            if (r<0.5) qs.push(_mcq(`${a}+${b}=?`,a+b,`${a}+${b}=${a+b}`,-10,10));
            else { if(a<b)[a,b]=[b,a]; qs.push(_mcq(`${a}-${b}=?`,a-b,`${a}-${b}=${a-b}`,-10,10)); }
        } else if (grade <= 4) {
            // G3-4：加减乘除混合（各25%概率），避免100%乘法
            if (r<0.25) { let a=rand(10,999),b=rand(10,999); qs.push(_mcq(`${a}+${b}=?`,a+b,`${a}+${b}=${a+b}`,-30,30)); }
            else if (r<0.5) { let a=rand(100,999),b=rand(10,999); if(a<b)[a,b]=[b,a]; qs.push(_mcq(`${a}-${b}=?`,a-b,`${a}-${b}=${a-b}`,-30,30)); }
            else if (r<0.75) { const a=rand(2,99),b=rand(2,9); qs.push(_mcq(`${a}×${b}=?`,a*b,`${a}×${b}=${a*b}`,-30,30)); }
            else { const b=rand(2,9), qt=rand(2,20); const a=b*qt; qs.push(_mcq(`${a}÷${b}=?`,qt,`${a}÷${b}=${qt}（${b}×${qt}=${a}）`,-10,10)); }
        } else {
            // G5-6：整数/小数/分数 四则混合（但不出现专题不相关的符号）
            if (r<0.2) { const a=rand(10,50),b=rand(10,50); qs.push(_mcq(`${a}×${b}=?`,a*b,`${a}×${b}=${a*b}`,-30,30)); }
            else if (r<0.4) { const b=rand(3,15), qt=rand(5,30); const a=b*qt; qs.push(_mcq(`${a}÷${b}=?`,qt,`${a}÷${b}=${qt}`,-15,15)); }
            else if (r<0.6) { const a=+(rand(1,50)+Math.random()).toFixed(2), b=+(rand(1,30)+Math.random()).toFixed(2); qs.push(_mcq(`${a}+${b}=?（保留两位小数）`, +(a+b).toFixed(2), `小数加法：对齐小数点相加 → ${+(a+b).toFixed(2)}`, -5, 5)); }
            else if (r<0.8) { const total=rand(30,150), f=rand(1,4), den=rand(3,8); if(f>=den){f=1;den=3;} qs.push(_mcq(`一共${total}个，拿走它的${f}/${den}，拿走几个？（取整）`, Math.round(total*f/den), `${total}×${f}/${den}≈${Math.round(total*f/den)}个`, -20, 20)); }
            else { qs.push({q:'四则运算的顺序：先乘除，后加减；有括号先算？',options:['括号里的','左边的','右边的','随便'],correct:0,explain:'括号优先级最高 → 先算括号里面的'}); }
        }
    }
    return _fin(qs);
}

