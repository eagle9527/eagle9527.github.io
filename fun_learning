function startPoemGame() {
    const selected = shuffle([...POEMS]).slice(0, 8);
    gameState = { type:'poem', list:selected, i:0, correct:0, wrong:0 };
    renderPoem();
}
function renderPoem() {
    const container = document.getElementById('gameModalBody');
    const q = gameState.list[gameState.i];
    const poemHtml = q.q[0].replace('____', `<span class="poem-blank">？？？</span>`);
    const optsHtml = q.opts.map((o, i) => {
        const cls = gameState.picked === i ? (i === q.ans ? 'btn-success' : 'btn-danger') : 'btn-primary';
        const dis = gameState.picked != null ? 'disabled' : '';
        return `<button class="btn ${cls}" style="font-size:17px;padding:12px 20px" ${dis} onclick="poemPick(${i})">${o}</button>`;
    }).join('');
    container.innerHTML = `
        <div style="max-width:600px;margin:0 auto;text-align:center">
            <div class="game-title">📜 古诗填空闯关 · 第 ${gameState.i+1} / ${gameState.list.length} 题</div>
            <div style="display:flex;justify-content:center;gap:25px;margin-bottom:15px;font-size:15px;flex-wrap:wrap">
                <span style="color:#27ae60"><b>✅ ${gameState.correct}</b></span>
                <span style="color:#e74c3c"><b>❌ ${gameState.wrong}</b></span>
            </div>
            <div class="poem-question">${poemHtml}</div>
            <div class="poem-option-row" style="margin-top:20px">${optsHtml}</div>
            ${gameState.picked != null ? `
                <div style="margin-top:20px;padding:15px 20px;background:${gameState.picked===q.ans?'#d4edda':'#f8d7da'};color:${gameState.picked===q.ans?'#155724':'#721c24'};border-radius:12px;text-align:left;font-size:15px;line-height:1.8">
                    <b>${gameState.picked===q.ans?'✅ 答对了！':'❌ 答错了'}</b><br>
                    📖 完整诗句：<b>${q.full}</b>
                </div>
                <div style="margin-top:20px">
                    <button class="btn btn-primary" onclick="poemNext()" style="font-size:16px;padding:12px 24px">
                        ${gameState.i===gameState.list.length-1 ? '🏆 查看结果' : '➡ 下一题'}
                    </button>
                </div>
            ` : ''}
            <div style="margin-top:25px">
                <button class="btn btn-info" onclick="closeGameModal()">🏠 返回大厅</button>
            </div>
        </div>
    `;
}
function poemPick(i) {
    if (gameState.picked != null) return;
    gameState.picked = i;
    if (i === gameState.list[gameState.i].ans) gameState.correct++;
    else gameState.wrong++;
    renderPoem();
}
function poemNext() {
    gameState.picked = null;
    if (gameState.i >= gameState.list.length - 1) {
        const stars = calcStars(gameState.correct, gameState.list.length, gameState.correct===gameState.list.length);
        finishGameResult('📜 古诗闯关结束！', stars>=3 ? '🏆' : '🎉', [
            `✅ 答对：<b style="color:#27ae60">${gameState.correct}</b> 题`,
            `❌ 答错：<b style="color:#e74c3c">${gameState.wrong}</b> 题`,
            `📝 共 <b>${gameState.list.length}</b> 首古诗词`,
            `🎯 正确率：<b>${Math.round(gameState.correct/gameState.list.length*100)}%</b>`,
        ], stars);
        return;
    }
    gameState.i++;
    renderPoem();
}

