function startMathRace() {
    gameState = { type: 'race', correct: 0, wrong: 0, answered: 0, timeLeft: 60, current: null };
    renderRaceQuestion();
    gameState._timer = setInterval(() => {
        gameState.timeLeft--;
        const el = document.querySelector('.math-timer');
        if (gameState.timeLeft <= 0) { clearInterval(gameState._timer); finishRace(); }
        else if (el) el.textContent = '⏱️ ' + gameState.timeLeft + '秒';
    }, 1000);
}
function genRaceQuestion() {
    const grade = appState.currentGrade;
    if (grade <= 2) {
        const a = rand(1, 20), b = rand(1, 20);
        if (Math.random() > 0.5) return { q: `${a} + ${b}`, a: a + b };
        const [x, y] = a >= b ? [a, b] : [b, a];
        return { q: `${x} - ${y}`, a: x - y };
    } else if (grade <= 4) {
        const type = rand(0, 2);
        if (type === 0) { const a=rand(2,12), b=rand(2,12); return { q:`${a} × ${b}`, a:a*b }; }
        if (type === 1) { const b=rand(2,12), a=b*rand(2,12); return { q:`${a} ÷ ${b}`, a:a/b }; }
        const a=rand(10,100), b=rand(10,100);
        return Math.random()>0.5 ? {q:`${a}+${b}`, a:a+b} : {q:`${a>b?a:b}-${a>b?b:a}`, a:Math.abs(a-b)};
    } else {
        const a=rand(10,99), b=rand(2,20);
        const type=rand(0,2);
        if (type===0) return {q:`${a} × ${b}`, a:a*b};
        if (type===1) { const x=b*rand(2,20); return {q:`${x} ÷ ${b}`, a:x/b}; }
        const c = rand(10, 99);
        return {q:`${a} + ${b} + ${c}`, a:a+b+c};
    }
}
function renderRaceQuestion() {
    gameState.current = genRaceQuestion();
    const container = document.getElementById('gameModalBody');
    container.innerHTML = `
