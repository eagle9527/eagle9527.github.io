        () => ({q:'定冠词"an"用在下列哪个单词前？',options:['book','pen','apple','desk'],correct:2,explain:'apple元音开头用an；book/pen/desk辅音开头用a。'}),
        () => ({q:'含有/juː/发音的字母是？',options:['U u','V v','W w','X x'],correct:0,explain:'Uu发音/juː/；Vv是/viː/；Ww是/ˈdʌbljuː/。'}),
        () => ({q:'英语句子第一个单词的首字母？',options:['小写','大写','随便','不用写'],correct:1,explain:'英语标点符号规则：每句话第一个单词首字母必须大写。'}),
