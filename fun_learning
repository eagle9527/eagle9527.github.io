<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎈 小学趣味学习乐园 - 语文·数学·英语·游戏</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    min-height: 100vh;
    color: #333;
}
.app-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}
/* 顶部栏 */
.header {
    background: rgba(255,255,255,0.95);
    border-radius: 20px;
    padding: 20px 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    margin-bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}
.header h1 {
    font-size: 28px;
    background: linear-gradient(90deg, #ff6b6b, #feca57, #48dbfb, #ff9ff3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.header .subtitle { font-size: 14px; color: #888; margin-top: 5px; }
.user-info {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
}
.grade-select {
    padding: 10px 15px;
    border-radius: 12px;
    border: 2px solid #667eea;
    font-size: 14px;
    background: white;
    cursor: pointer;
    outline: none;
}
.progress-bar-container {
    min-width: 180px;
}
.progress-label {
    font-size: 13px;
    color: #666;
    margin-bottom: 5px;
    display: flex;
    justify-content: space-between;
}
.progress-bar {
    height: 14px;
    background: #eee;
    border-radius: 10px;
    overflow: hidden;
}
.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #00b894, #00cec9);
    border-radius: 10px;
    transition: width 0.5s ease;
}
.stars-display {
    font-size: 22px;
    background: linear-gradient(90deg, #feca57, #ff9f43);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: bold;
}
.action-btns { display: flex; gap: 8px; flex-wrap: wrap; }
.btn {
    padding: 10px 18px;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }
.btn-primary { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
.btn-success { background: linear-gradient(135deg, #00b894, #00cec9); color: white; }
.btn-warning { background: linear-gradient(135deg, #feca57, #ff9f43); color: white; }
.btn-danger { background: linear-gradient(135deg, #ff6b6b, #ee5a24); color: white; }
.btn-info { background: linear-gradient(135deg, #48dbfb, #0abde3); color: white; }

/* 导航标签 */
.tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}
.tab {
    flex: 1;
    min-width: 130px;
    padding: 18px 15px;
    background: rgba(255,255,255,0.95);
    border-radius: 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
    font-size: 16px;
    font-weight: bold;
    border: 3px solid transparent;
}
.tab:hover { transform: translateY(-4px); }
.tab.active {
    transform: translateY(-4px);
    border-color: currentColor;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}
.tab-chinese { color: #e74c3c; }
.tab-math { color: #3498db; }
.tab-english { color: #27ae60; }
.tab-game { color: #9b59b6; }
.tab-icon { font-size: 32px; display: block; margin-bottom: 6px; }

/* 主内容区 */
.panel {
    background: rgba(255,255,255,0.97);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.15);
    min-height: 500px;
}
.panel.hidden { display: none; }

/* 主题色标题 */
.section-title {
    font-size: 24px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 3px dashed #eee;
    display: flex;
    align-items: center;
    gap: 10px;
}

/* 知识卡片网格 */
.topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 18px;
    margin-bottom: 30px;
}
.topic-card {
    background: white;
    border-radius: 16px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s;
    border: 2px solid #eee;
    position: relative;
    overflow: hidden;
}
.topic-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.15);
}

.topic-card.completed {
    border-color: #00b894;
    background: linear-gradient(135deg, #e8f8f5, #d1f2eb);
}
.topic-status {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 20px;
}
.topic-icon {
    font-size: 40px;
    margin-bottom: 10px;
}
.topic-name {
    font-size: 17px;
    font-weight: bold;
    margin-bottom: 8px;
}
.topic-desc {
    font-size: 13px;
    color: #888;
    line-height: 1.5;
}
.topic-progress-text {
    margin-top: 10px;
    font-size: 12px;
    color: #666;
}

/* 学习模态框 */
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.6);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    padding: 20px;
}
.modal-overlay.show { display: flex; }
body.modal-open { overflow: hidden; }
.modal {
    background: white;
    border-radius: 20px;
    width: 100%;
    max-width: 700px;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}
.game-modal { max-width: 980px; max-height: 90vh; }
.modal-header-game {
    padding: 18px 28px;
    background: linear-gradient(135deg, #9b59b6, #e74c3c);
    color: white;
    border-radius: 20px 20px 0 0;
    display: flex; align-items: center; justify-content: space-between;
}
.modal-header-game .modal-title { font-size: 20px; font-weight: bold; }
.modal-header-game .modal-close {
    background: rgba(255,255,255,0.25);
    color: white; width: 38px; height: 38px; border-radius: 50%;
    border: none; font-size: 26px; line-height: 34px; cursor: pointer;
}
.modal-header {
    padding: 25px 30px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border-radius: 20px 20px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
}
.modal-header.chinese { background: linear-gradient(135deg, #e74c3c, #c0392b); }
.modal-header.math { background: linear-gradient(135deg, #3498db, #2980b9); }
.modal-header.english { background: linear-gradient(135deg, #27ae60, #1e8449); }
.modal-header.game { background: linear-gradient(135deg, #9b59b6, #8e44ad); }
.modal-title { font-size: 22px; }
.modal-close {
    background: rgba(255,255,255,0.2);
    border: none;
    color: white;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
}
.modal-body { padding: 30px; }
.question-area {
    background: #f8f9fa;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 20px;
}
.question-text {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 20px;
    line-height: 1.6;
}
.question-meta {
    font-size: 13px;
    color: #888;
    margin-bottom: 15px;
    display: flex;
    gap: 15px;
}
.options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
}
.option-btn {
    padding: 15px 20px;
    background: white;
    border: 2px solid #ddd;
    border-radius: 12px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.2s;
    text-align: left;
}
.option-btn:hover:not(:disabled) {
    border-color: #667eea;
    background: #f5f3ff;
    transform: translateX(4px);
}
.option-btn.correct {
    background: #d4edda;
    border-color: #28a745;
    color: #155724;
}
.option-btn.wrong {
    background: #f8d7da;
    border-color: #dc3545;
    color: #721c24;
}
.option-btn:disabled { cursor: default; }
.explanation {
    margin-top: 15px;
    padding: 15px;
    background: #fff3cd;
    border-radius: 10px;
    border-left: 4px solid #ffc107;
    font-size: 14px;
    line-height: 1.6;
    display: none;
}
.explanation.show { display: block; }
.modal-footer {
    padding: 20px 30px;
    border-top: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
}
.question-nav { display: flex; gap: 8px; align-items: center; }
.score-display {
    padding: 8px 16px;
    background: linear-gradient(135deg, #feca57, #ff9f43);
    color: white;
    border-radius: 20px;
    font-weight: bold;
}

/* 奖励弹窗 */
.reward-modal {
    text-align: center;
    padding: 40px;
}
.reward-emoji {
    font-size: 80px;
    animation: bounce 1s infinite;
}
@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}
.reward-title {
    font-size: 32px;
    margin: 20px 0;
    color: #e74c3c;
}
.reward-stars {
    font-size: 50px;
    margin: 20px 0;
}
.reward-message {
    font-size: 16px;
    color: #666;
    margin-bottom: 20px;
    line-height: 1.8;
}

/* 游戏区域 */
.game-area {
    background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
    border-radius: 20px;
    padding: 30px;
    min-height: 400px;
}
.game-title {
    font-size: 22px;
    margin-bottom: 15px;
    text-align: center;
    color: #333;
}

/* 消消乐游戏 */
.match-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    max-width: 500px;
    margin: 20px auto;
}
.match-item {
    aspect-ratio: 1;
    background: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s;
    border: 3px solid transparent;
    user-select: none;
}
.match-item:hover { transform: scale(1.05); }
.match-item.selected {
    border-color: #667eea;
    background: #f5f3ff;
}
.match-item.matched {
    background: #d4edda;
    opacity: 0.5;
    pointer-events: none;
}

/* 口算游戏 */
.math-quiz {
    max-width: 500px;
    margin: 0 auto;
    text-align: center;
}
.math-question {
    font-size: 48px;
    font-weight: bold;
    margin: 30px 0;
    color: #3498db;
}
.math-input {
    width: 200px;
    padding: 15px;
    font-size: 28px;
    text-align: center;
    border: 3px solid #3498db;
    border-radius: 12px;
    outline: none;
}
.math-timer {
    font-size: 20px;
    color: #e74c3c;
    font-weight: bold;
}

/* 首页统计 */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
    margin-bottom: 30px;
}
.stat-card {
    padding: 20px;
    border-radius: 16px;
    color: white;
    text-align: center;
}
.stat-card:nth-child(1) { background: linear-gradient(135deg, #ff9a9e, #fad0c4); }
.stat-card:nth-child(2) { background: linear-gradient(135deg, #a1c4fd, #c2e9fb); }
.stat-card:nth-child(3) { background: linear-gradient(135deg, #d4fc79, #96e6a1); }
.stat-card:nth-child(4) { background: linear-gradient(135deg, #ffecd2, #fcb69f); }
.stat-value { font-size: 36px; font-weight: bold; }
.stat-label { font-size: 14px; opacity: 0.9; margin-top: 5px; }

/* 最近学习 */
.recent-section h3 {
    margin-bottom: 15px;
    color: #555;
}
.recent-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.recent-tag {
    padding: 8px 16px;
    background: #f0f0f0;
    border-radius: 20px;
    font-size: 14px;
}

/* 游戏大厅 大卡片样式 */
.game-hall-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 18px;
    margin-bottom: 20px;
}
.game-card {
    background: white;
    border-radius: 18px;
    padding: 22px 18px;
    cursor: pointer;
    transition: all 0.3s;
    border: 3px solid transparent;
    position: relative;
    overflow: hidden;
    text-align: center;
}
.game-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgba(0,0,0,0.18);
}
.game-card::before {
    content: '';
    position: absolute;
    top: -30px; right: -30px;
    width: 100px; height: 100px;
    border-radius: 50%;
    opacity: 0.15;
}
.game-card[data-cat="chinese"]::before { background: #e74c3c; }
.game-card[data-cat="math"]::before { background: #3498db; }
.game-card[data-cat="english"]::before { background: #27ae60; }
.game-card[data-cat="mixed"]::before { background: #9b59b6; }
.game-card[data-cat="chinese"]:hover { border-color: #e74c3c; }
.game-card[data-cat="math"]:hover { border-color: #3498db; }
.game-card[data-cat="english"]:hover { border-color: #27ae60; }
.game-card[data-cat="mixed"]:hover { border-color: #9b59b6; }
.game-card-icon {
    font-size: 52px;
    margin-bottom: 10px;
    position: relative;
    z-index: 1;
}
.game-card-name {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 6px;
    position: relative;
    z-index: 1;
}
.game-card-desc {
    font-size: 13px;
    color: #777;
    line-height: 1.5;
    position: relative;
    z-index: 1;
}
.game-card-tag {
    display: inline-block;
    margin-top: 10px;
    padding: 3px 10px;
    border-radius: 10px;
    font-size: 12px;
    color: white;
    position: relative;
    z-index: 1;
}
.game-card-tag.chinese { background: #e74c3c; }
.game-card-tag.math { background: #3498db; }
.game-card-tag.english { background: #27ae60; }
.game-card-tag.mixed { background: #9b59b6; }

.game-diff-select {
    padding: 10px 16px;
    border-radius: 10px;
    border: 2px solid #9b59b6;
    background: white;
    font-size: 14px;
    margin: 0 8px;
    outline: none;
}

/* 记忆翻牌 */
.memory-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    max-width: 520px;
    margin: 20px auto;
    perspective: 1000px;
}
.memory-card {
    aspect-ratio: 3/4;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.5s;
    cursor: pointer;
    user-select: none;
}
.memory-card.flipped { transform: rotateY(180deg); }
.memory-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: bold;
    text-align: center;
    padding: 4px;
}
.memory-front {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    font-size: 40px;
}
.memory-back {
    background: white;
    transform: rotateY(180deg);
    border: 3px solid #ddd;
    color: #333;
}
.memory-card.matched .memory-back {
    background: linear-gradient(135deg, #a8edea, #fed6e3);
    border-color: #00b894;
}

/* 打地鼠 */
.whack-area {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    max-width: 420px;
    margin: 20px auto;
}
.whack-hole {
    aspect-ratio: 1;
    background: radial-gradient(circle at 50% 60%, #6b4f1a, #3d2b0e);
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    border: 6px solid #8b5a2b;
}
.whack-mole {
    position: absolute;
    left: 10%;
    width: 80%;
    height: 80%;
    background: linear-gradient(180deg, #b97a56, #8b5a3c);
    border-radius: 50% 50% 45% 45%;
    bottom: -100%;
    transition: bottom 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    font-weight: bold;
    color: white;
    text-align: center;
    padding: 5px;
    line-height: 1.1;
}
.whack-hole.up .whack-mole { bottom: 10%; }
.whack-hole.hit .whack-mole {
    background: linear-gradient(180deg, #e74c3c, #c0392b);
    transform: scale(1.1);
}

/* 大转盘 */
.wheel-wrap {
    position: relative;
    width: 360px;
    max-width: 90%;
    aspect-ratio: 1;
    margin: 20px auto;
}
.wheel-svg {
    width: 100%;
    height: 100%;
    transition: transform 4s cubic-bezier(0.15, 0.9, 0.3, 1);
}
.wheel-pointer {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 42px;
    z-index: 2;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
}
.wheel-center-btn {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 72px; height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff6b6b, #c0392b);
    color: white;
    font-weight: bold;
    border: 4px solid white;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    cursor: pointer;
    font-size: 16px;
    z-index: 3;
}
.wheel-center-btn:disabled { opacity: 0.6; cursor: not-allowed; }

/* 数字炸弹 */
.bomb-range {
    font-size: 26px;
    font-weight: bold;
    color: #333;
    margin: 16px 0;
}
.bomb-range span {
    display: inline-block;
    padding: 6px 14px;
    background: #ffeaa7;
    border-radius: 10px;
    margin: 0 4px;
    color: #d35400;
}

/* 打字练习 */
.typing-target {
    font-size: 52px;
    font-weight: bold;
    color: #667eea;
    letter-spacing: 8px;
    margin: 20px 0;
    font-family: 'Courier New', monospace;
}
.typing-input {
    font-size: 32px;
    padding: 12px 20px;
    border: 3px solid #667eea;
    border-radius: 12px;
    text-align: center;
    letter-spacing: 6px;
    outline: none;
    font-family: 'Courier New', monospace;
    width: 280px;
}
.typing-char.correct { color: #27ae60; }
.typing-char.wrong { color: #e74c3c; text-decoration: underline wavy; }
.typing-char.current { background: #fff3cd; border-radius: 4px; }

/* 古诗填空 */
.poem-question {
    font-size: 24px;
    line-height: 2;
    margin: 20px 0;
    color: #8e44ad;
}
.poem-blank {
    display: inline-block;
    min-width: 80px;
    border-bottom: 3px dashed #8e44ad;
    margin: 0 6px;
    text-align: center;
    color: #8e44ad;
    font-weight: bold;
}
.poem-option-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 10px;
    max-width: 600px;
    margin: 10px auto;
}

/* 响应式 */
@media (max-width: 768px) {
    .header { padding: 15px; }
    .header h1 { font-size: 22px; }
    .panel { padding: 20px; }
    .modal-body { padding: 20px; }
    .topic-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .question-text { font-size: 17px; }
    .math-question { font-size: 36px; }
    .game-hall-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
    .game-card-icon { font-size: 42px; }
    .game-card-name { font-size: 16px; }
    .memory-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .whack-area { gap: 10px; }
}
</style>
</head>
<body>

<div class="app-container">
    <!-- 顶部栏 -->
    <div class="header">
        <div>
            <h1>🎈 小学趣味学习乐园</h1>
            <div class="subtitle">语文 · 数学 · 英语 · 游戏闯关 | 循序渐进 | 自动保存学习进度</div>
