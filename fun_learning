}
function finishTyping() {
    const done = gameState.correct + gameState.wrong || 1;
    const rate = Math.round(gameState.correct / done * 100);
    const sec = 90 - gameState.time;
    const wpm = Math.round(gameState.correct / Math.max(1, sec/60));
    const stars = calcStars(gameState.correct, gameState.words.length, rate>=90 && wpm>=5);
    finishGameResult('⌨️ 打字练习结束！', stars>=3 ? '🏆' : '🎉', [
        `✅ 打对：<b style="color:#27ae60">${gameState.correct}</b> 个单词`,
