function startMatchGame(subject) {
    const pairs = [...MATCH_GAMES[subject]];
    const shuffled = shuffle([...pairs.flatMap(p => [{type:'left', value:p.left, match:p.right}, {type:'right', value:p.right, match:p.left}])]);
    gameState = { type: 'match', subject, items: shuffled, selected: null, matched: new Set(), moves: 0, startTime: Date.now() };
    renderMatchGame();
}
function renderMatchGame() {
    const container = document.getElementById('gameModalBody');
    const items = gameState.items;
    const gridHtml = items.map((it, idx) => {
        const matched = gameState.matched.has(idx);
        const selected = gameState.selected === idx;
        return `<div class="match-item ${matched ? 'matched':''} ${selected ? 'selected':''}" data-idx="${idx}">${it.value}</div>`;
    }).join('');
    const subjName = {chinese:'语文', math:'数学', english:'英语'}[gameState.subject];
    container.innerHTML = `
        <div style="width:100%">
            <div class="game-title">${subjName}连连看 · 找出匹配的一对</div>
            <div style="display:flex;justify-content:center;gap:30px;margin-bottom:20px;font-size:15px;color:#555;flex-wrap:wrap">
                <span>步数：${gameState.moves}</span>
                <span>已匹配：${gameState.matched.size/2} / ${gameState.items.length/2}</span>
            </div>
            <div class="match-grid">${gridHtml}</div>
            <div style="text-align:center;margin-top:20px">
                <button class="btn btn-warning" onclick="startMatchGame('${gameState.subject}')">🔄 重新开始</button>
                <button class="btn btn-info" onclick="closeGameModal()">🏠 大厅</button>
            </div>
        </div>
    `;
    container.querySelectorAll('.match-item').forEach(el => {
        el.addEventListener('click', () => onMatchItemClick(parseInt(el.dataset.idx)));
    });
}
function onMatchItemClick(idx) {
    if (gameState.matched.has(idx)) return;
    if (gameState.selected === idx) return;
    if (gameState.selected === null) {
        gameState.selected = idx;
        renderMatchGame();
        return;
    }
    const a = gameState.items[gameState.selected];
    const b = gameState.items[idx];
    gameState.moves++;
    if (a.match === b.value && a.type !== b.type) {
        gameState.matched.add(gameState.selected);
        gameState.matched.add(idx);
        gameState.selected = null;
        renderMatchGame();
        if (gameState.matched.size === gameState.items.length) {
            const time = Math.round((Date.now() - gameState.startTime)/1000);
            const stars = Math.max(1, 6 - Math.floor(gameState.moves/4));
            setTimeout(() => {
                finishGameResult('🎉 全部匹配完成！', '🎊', [
                    `⏱️ 用时：<b>${time}</b> 秒`,
                    `🎯 步数：<b>${gameState.moves}</b> 步`,
                    `📦 配对数量：<b>${gameState.items.length/2}</b> 对`,
                ], Math.min(5, stars));
            }, 300);
        }
    } else {
        const prev = gameState.selected;
        const el1 = document.querySelectorAll('.match-item')[prev];
        const el2 = document.querySelectorAll('.match-item')[idx];
        if (el1) el1.style.background = '#f8d7da';
        if (el2) el2.style.background = '#f8d7da';
        setTimeout(() => {
            gameState.selected = null;
            renderMatchGame();
        }, 400);
    }
}

