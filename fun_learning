function startWheelGame() {
    gameState = { type:'wheel', rot:0, total:0, correct:0, running:false, q:null, picked:null, rounds:0, maxRounds:5 };
    renderWheel();
}
function renderWheel() {
    const container = document.getElementById('gameModalBody');
    const cats = ['语文','语文','数学','数学','英语','英语','综合','综合'];
    const colors = ['#ff6b6b','#feca57','#48dbfb','#1dd1a1','#ff9ff3','#54a0ff','#5f27cd','#ff9f43'];
    const n = cats.length;
    const anglePer = 360 / n;
    let paths = '';
    let texts = '';
    const R = 160, cx = 180, cy = 180;
    cats.forEach((c, i) => {
        const a1 = (i * anglePer - 90) * Math.PI / 180;
        const a2 = ((i+1) * anglePer - 90) * Math.PI / 180;
        const x1 = cx + R*Math.cos(a1), y1 = cy + R*Math.sin(a1);
        const x2 = cx + R*Math.cos(a2), y2 = cy + R*Math.sin(a2);
        const large = anglePer > 180 ? 1 : 0;
        paths += `<path d="M${cx},${cy} L${x1},${y1} A${R},${R} 0 ${large} 1 ${x2},${y2} Z" fill="${colors[i]}" stroke="white" stroke-width="3"></path>`;
        // 文字位置
        const ta = ((i+0.5)*anglePer - 90) * Math.PI / 180;
        const tx = cx + (R*0.62) * Math.cos(ta);
        const ty = cy + (R*0.62) * Math.sin(ta);
        const rot = (i+0.5)*anglePer;
        texts += `<text x="${tx}" y="${ty}" font-size="18" font-weight="bold" fill="white" text-anchor="middle" dominant-baseline="middle" transform="rotate(${rot} ${tx} ${ty})">${c}</text>`;
    });
    const qHtml = gameState.q ? `
        <div style="max-width:500px;margin:20px auto 10px;background:#fff3cd;padding:15px 20px;border-radius:14px;text-align:left;line-height:1.7">
            <div style="font-size:15px;color:#856404;margin-bottom:6px">🎯 【${gameState.q.cat}】第 ${gameState.rounds}/${gameState.maxRounds} 轮</div>
            <div style="font-size:17px;font-weight:bold;color:#5b4700">${gameState.q.q}</div>
            <div style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px">
                ${gameState.q.opts.map((o,i)=>{
                    let cls = 'btn-primary';
                    if (gameState.picked!=null) {
                        if (i === gameState.q.ans) cls = 'btn-success';
                        else if (i === gameState.picked) cls = 'btn-danger';
                    }
                    return `<button class="btn ${cls}" ${gameState.picked!=null?'disabled':''} onclick="wheelPick(${i})">${String.fromCharCode(65+i)}. ${o}</button>`;
                }).join('')}
            </div>
        </div>
        <div style="margin-top:10px;display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
            ${gameState.picked!=null ? `<button class="btn btn-primary" onclick="wheelNext()" style="font-size:16px;padding:12px 24px">${gameState.rounds>=gameState.maxRounds?'🏆 查看结果':'🎡 继续转下一题'}</button>` : ''}
            <button class="btn btn-info" onclick="closeGameModal()">🏠 返回大厅</button>
        </div>
    ` : '';
    container.innerHTML = `
        <div style="width:100%;text-align:center">
            <div class="game-title">🎡 知识幸运大转盘</div>
            <div style="font-size:14px;color:#666;margin-bottom:5px">
                点击「GO」转动转盘 · 答对 <b style="color:#27ae60">${gameState.correct}</b> / 共 <b>${gameState.rounds}</b> 题 · 共 5 轮
            </div>
            <div class="wheel-wrap">
                <div class="wheel-pointer">▼</div>
                <svg class="wheel-svg" viewBox="0 0 360 360" style="transform:rotate(${gameState.rot}deg)">
                    <circle cx="180" cy="180" r="175" fill="white" stroke="#eee" stroke-width="4"></circle>
                    ${paths}
                    ${texts}
                </svg>
                <button class="wheel-center-btn" id="wheelBtn" onclick="wheelSpin()" ${gameState.running||gameState.q&&gameState.picked==null?'disabled':''}>
                    ${gameState.running ? '转动中' : 'GO!'}
                </button>
            </div>
            ${qHtml}
        </div>
    `;
}
function wheelSpin() {
    if (gameState.running) return;
    if (gameState.rounds >= gameState.maxRounds) {
        wheelFinish(); return;
    }
    gameState.running = true;
    const spin = 360 * (4 + Math.random()*2) + rand(0, 359);
    gameState.rot += spin;
    renderWheel();
    setTimeout(() => {
        gameState.running = false;
        // 根据落点选分类
        const final = (gameState.rot % 360 + 360) % 360;
        // 指针在上方(0度/12点方向)，反向减，逆时针
        const idx = Math.floor(((360 - final) % 360) / 45) % 8;
        const cats = ['语文','语文','数学','数学','英语','英语','综合','综合'];
        const cat = cats[idx];
        // 抽对应分类的题
        const pool = WHEEL_QUESTIONS.filter(q => q.cat === cat);
        const pick = pool[rand(0, pool.length-1)];
        gameState.q = pick;
        gameState.picked = null;
        gameState.rounds++;
        renderWheel();
    }, 4100);
}
function wheelPick(i) {
    if (gameState.picked != null) return;
    gameState.picked = i;
    if (i === gameState.q.ans) gameState.correct++;
    renderWheel();
}
function wheelNext() {
    if (gameState.rounds >= gameState.maxRounds) { wheelFinish(); return; }
    gameState.q = null;
    gameState.picked = null;
    renderWheel();
}
function wheelFinish() {
    const stars = calcStars(gameState.correct, gameState.maxRounds, gameState.correct===gameState.maxRounds);
    finishGameResult('🎡 幸运大转盘结束！', stars>=3 ? '🏆' : '🎉', [
        `✅ 答对：<b style="color:#27ae60">${gameState.correct}</b> 题`,
        `❌ 答错：<b style="color:#e74c3c">${gameState.rounds - gameState.correct}</b> 题`,
        `📝 共转了 <b>${gameState.rounds}</b> 轮`,
        `🎯 正确率：<b>${Math.round(gameState.correct/gameState.rounds*100)}%</b>`,
    ], stars);
}

/* ==================== 工具函数 ==================== */
function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i+1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
}
function rand(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

/* ==================== 导入导出 ==================== */

function exportProgress() {
    const data = JSON.stringify(appState, null, 2);
    const blob = new Blob([data], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const now = new Date();
    const pad = n => n.toString().padStart(2, '0');
    a.download = `小学学习进度_${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}.json`;
    a.href = url;
    a.click();
    URL.revokeObjectURL(url);
}

function importProgress(file) {
    const reader = new FileReader();
    reader.onload = e => {
        try {
            const data = JSON.parse(e.target.result);
            if (typeof data === 'object' && data.completed) {
                if (confirm('确定要覆盖当前进度吗？')) {
                    appState = Object.assign(appState, data);
                    saveState();
                    document.getElementById('gradeSelect').value = appState.currentGrade;
                    renderAllSubjects();
                    renderGamePanel();
                    alert('✅ 进度导入成功！');
                }
            } else {
                alert('❌ 文件格式不正确');
            }
        } catch(err) {
            alert('❌ 导入失败：' + err.message);
        }
    };
    reader.readAsText(file);
}

/* ==================== 初始化与事件绑定 ==================== */

function init() {
    loadState();
    document.getElementById('gradeSelect').value = appState.currentGrade;
    renderAllSubjects();
    renderGamePanel();

    // Tab切换
    document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            ['chinese', 'math', 'english', 'game'].forEach(p => {
                document.getElementById(p + 'Panel').classList.toggle('hidden', p !== tab.dataset.tab);
            });
        });
    });

    // 游戏弹框关闭按钮 + 遮罩点击关闭
    document.getElementById('gameModalClose').addEventListener('click', closeGameModal);
    document.getElementById('gameModal').addEventListener('click', e => {
        if (e.target.id === 'gameModal') closeGameModal();
    });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            if (document.getElementById('studyModal').classList.contains('show')) closeStudyModal();
            else if (document.getElementById('gameModal').classList.contains('show')) closeGameModal();
        }
    });

    // 年级选择
    document.getElementById('gradeSelect').addEventListener('change', e => {
        appState.currentGrade = parseInt(e.target.value);
        saveState();
        renderAllSubjects();
    });

    // 模态框关闭
    document.getElementById('modalClose').addEventListener('click', closeStudyModal);
    document.getElementById('studyModal').addEventListener('click', e => {
        if (e.target.id === 'studyModal') closeStudyModal();
    });
    document.getElementById('prevQuestion').addEventListener('click', () => {
        if (!currentSession) return;
        if (currentSession.currentIndex > 0) {
            currentSession.currentIndex--;
            renderQuestion();
        }
    });
    document.getElementById('nextQuestion').addEventListener('click', () => {
        if (!currentSession) return;
        const s = currentSession;
        if (s.currentIndex === s.questions.length - 1) {
            if (s.answers.every(a => a)) {
                submitQuiz();
            }
            return;
        }
        s.currentIndex++;
        renderQuestion();
    });

    document.getElementById('rewardClose').addEventListener('click', () => {
        document.getElementById('rewardModal').classList.remove('show');
    });

    // 导入导出重置
    document.getElementById('exportBtn').addEventListener('click', exportProgress);
    document.getElementById('importBtn').addEventListener('click', () => document.getElementById('fileInput').click());
    document.getElementById('fileInput').addEventListener('change', e => {
        if (e.target.files[0]) importProgress(e.target.files[0]);
        e.target.value = '';
    });
    document.getElementById('resetBtn').addEventListener('click', () => {
        if (confirm('⚠️ 确定要清空所有学习进度吗？\n此操作不可恢复！')) {
            if (confirm('再次确认：真的要重置所有进度吗？')) {
                localStorage.removeItem(STORAGE_KEY);
                appState = {
                    currentGrade: 1, stars: 0, completed: {},
                    recent: [], createdAt: Date.now(),
                };
                saveState();
                document.getElementById('gradeSelect').value = 1;
                renderAllSubjects();
                renderGamePanel();
                alert('✅ 已重置');
            }
        }
    });
}

// 页面加载完成自动初始化
document.addEventListener('DOMContentLoaded', init);
// 兼容可能加载慢的情况
if (document.readyState === 'interactive' || document.readyState === 'complete') {
    init();
}
</script>
