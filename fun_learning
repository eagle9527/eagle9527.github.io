    else gameState.wrong++;
    renderRaceQuestion();
}
function stopRace() {
    if (gameState._timer) clearInterval(gameState._timer);
    finishRace();
}
function finishRace() {
    if (gameState.type !== 'race') return;
    const correct = gameState.correct;
    const answered = gameState.answered || 1;
    const rate = Math.round(correct/answered*100);
    const stars = calcStars(correct, answered, correct>=30 && rate>=90);
    finishGameResult('挑战结束！', stars>=3 ? '🏆' : stars>=1 ? '🎉' : '💪', [
        `✅ 答对：<b style="color:#27ae60">${correct}</b> 题`,
